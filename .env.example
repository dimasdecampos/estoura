# Supabase > Project Settings > API (ou o botão "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# "Publishable key" (começa com sb_publishable_...) — ou a antiga "anon key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Notificações push (avisos no celular/computador mesmo com o app fechado). Gere o par de chaves com:
#   npx web-push generate-vapid-keys
# A chave pública é entregue ao navegador; a PRIVADA fica só no servidor (nunca com NEXT_PUBLIC_).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
